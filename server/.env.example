# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=production
PORT=5000

# MongoDB Atlas: use a dedicated database user with readWrite on ONE database only (not an Atlas admin user)
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/aevum?retryWrites=true&w=majority

# At least 32 chars. Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Browser origins allowed to call this API (comma separated, no trailing slash)
CLIENT_ORIGINS=https://aevum-ashy.vercel.app

# Reverse proxies in front of the app (Render/Railway/Heroku = 1, local = 0)
TRUST_PROXY=1

# Payment screenshot storage (recommended for any host with a temporary disk, e.g. Render free).
# Create a free account at cloudinary.com, then copy "API Environment variable" from the dashboard:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# (or set CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET separately)
# Leave empty in local development to save screenshots on disk instead.
CLOUDINARY_URL=

# Gmail App Password (not your real password)
EMAIL_USER=
EMAIL_PASS=
